# Local development environment template.
# Copy this file to .env.local and fill in real values.
# Do not commit .env.local.

# Database
DATABASE_URL="postgresql://example.invalid/grit?sslmode=require"

# Editor access
EDITOR_PASSWORD="replace-with-a-local-editor-password"

# Cloudflare Turnstile CAPTCHA.
# TURNSTILE_SITE_KEY is public but kept here so local dev and Docker use the same name.
TURNSTILE_SITE_KEY="your-site-key-here"
TURNSTILE_SECRET_KEY="your-secret-key-here"

# Email notifications.
# Leave RESEND_API_KEY empty to skip email sends in local development.
RESEND_API_KEY="re_your_api_key_here"
EDITOR_EMAIL="primary-recipient@example.com"
EDITOR_EMAIL_BCC="griteditor@sandiahomeowners.org"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
