# Neon Postgres Database
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Cloudflare Turnstile CAPTCHA
# Get these from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY="your-site-key-here"
TURNSTILE_SECRET_KEY="your-secret-key-here"

# Resend Email Notifications
# Get API key from: https://resend.com/api-keys
# FROM: noreply@sandiaheightsgrit.app (verify this domain in Resend)
# REPLY-TO: griteditor@sandiahomeowners.org
# BCC: griteditor@sandiahomeowners.org
RESEND_API_KEY="re_your_api_key_here"
EDITOR_EMAIL="griteditor@sandiahomeowners.org"
EDITOR_EMAIL_BCC="griteditor@sandiahomeowners.org"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Editor Password (server-side only)
EDITOR_PASSWORD=your_editor_password_here
