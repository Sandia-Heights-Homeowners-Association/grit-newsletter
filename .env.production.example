# Docker/DigitalOcean production environment template.
# Copy this file to .env.production on the server.
# Do not commit the real .env.production file.

NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"

# Public URL used in generated editor links inside emails.
NEXT_PUBLIC_SITE_URL="https://your-production-domain.example"

# Database
DATABASE_URL="postgresql://example.invalid/grit?sslmode=require"

# Editor access
EDITOR_PASSWORD="replace-with-a-long-random-editor-password"

# Cloudflare Turnstile.
# TURNSTILE_SITE_KEY is public but should still be configured per environment.
TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"

# Resend email
RESEND_API_KEY="re_replace_with_api_key"
EDITOR_EMAIL="griteditor@sandiahomeowners.org"
EDITOR_EMAIL_BCC="griteditor@sandiahomeowners.org"
